# ── 依赖 ────────────────────────────────────────────────────────────────
# 只有 typescript 与 @tauri-apps/cli 两个开发依赖，用 `npm install` 还原
node_modules/

# ── 构建产物 ────────────────────────────────────────────────────────────
# 前端产物：`npm run build` = tsc + 静态资源拷贝，随时可重建
dist/

# 界面预览产物：`node scripts/preview.mjs` 生成，仅供本地看一眼
.preview/

# Rust 构建目录（release 产物含安装包，体积以 GB 计）
src-tauri/target/

# Tauri 在编译期生成的权限 schema，由 build.rs 自动重建
src-tauri/gen/schemas/

# ── 编辑器 / IDE ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── 操作系统 ────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# ── 日志与临时文件 ──────────────────────────────────────────────────────
*.log
*.tmp
