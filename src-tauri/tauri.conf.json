{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LyricTag",
  "version": "1.0.0",
  "identifier": "com.lyrictag.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "LyricTag",
        "width": 1400,
        "height": 880,
        "minWidth": 1060,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": true,
        "visible": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
